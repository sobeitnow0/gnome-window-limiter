#: prefs.js
msgid "Settings"
msgstr "Configurações"

#: prefs.js
msgid "Window Limits & Behavior"
msgstr "Limites de janelas e comportamento"

#: prefs.js
msgid "Configure maximum allowed windows per workspace and transition behavior."
msgstr "Configure o número máximo de janelas por workspace e o comportamento de transição."

#: prefs.js
msgid "Window Limit"
msgstr "Limite de janelas"

#: prefs.js
msgid "Maximum number of normal windows allowed per workspace (0 for unlimited)."
msgstr "Número máximo de janelas normais por workspace (0 para ilimitado)."

#: prefs.js
msgid "Auto-Switch Workspace"
msgstr "Trocar automaticamente de workspace"

#: prefs.js
msgid "Automatically switch view and focus to the target workspace when a window is moved."
msgstr "Mudar automaticamente a visualização e foco para o workspace de destino quando uma janela for movida."

#: prefs.js
msgid "Smart Workspace Fill"
msgstr "Preenchimento inteligente de workspaces"

#: prefs.js
msgid "Place excess windows on the next workspace with available space before creating a new one."
msgstr "Mover janelas excedentes para o próximo workspace com espaço disponível antes de criar um novo."

#: prefs.js
msgid "Exclusions & Filters"
msgstr "Exclusões e filtros"

#: prefs.js
msgid "Fine-tune which windows count towards the workspace limit."
msgstr "Ajuste fino de quais janelas contam para o limite do workspace."

#: prefs.js
msgid "Count Minimized Windows"
msgstr "Contar janelas minimizadas"

#: prefs.js
msgid "Include minimized windows when calculating the current workspace window limit."
msgstr "Incluir janelas minimizadas no cálculo do limite de janelas do workspace."

#: prefs.js
msgid "Apply Only to Primary Monitor"
msgstr "Aplicar somente ao monitor principal"

#: prefs.js
msgid "Ignore secondary monitor windows if workspaces are set to primary monitor only."
msgstr "Ignorar janelas em monitores secundários se os workspaces estiverem restritos ao monitor principal."

#: prefs.js
msgid "Window Blacklist"
msgstr "Lista de exceções (Blacklist)"

#: prefs.js
msgid "Comma-separated titles, classes, or App IDs to ignore (e.g. \"chatgpt, vicinae, vlc\")."
msgstr "Títulos, classes WM_CLASS ou App IDs separados por vírgula para ignorar (ex: \"chatgpt, vicinae, vlc\")."
